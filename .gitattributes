# Normalize all text to LF, in the repo and in working copies, on every OS.
* text=auto eol=lf

# Binary files: never normalize or diff as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.zip    binary
*.nupkg  binary
*.snupkg binary
*.snk    binary
*.dll    binary
*.exe    binary
*.woff   binary
*.woff2  binary
